# ---- Hugging Face ----
# 国内网络直接访问 huggingface.co 会超时，这里指向镜像站。
# 如果你在校园网 / 有代理能直连官方站，把下面两行注释掉即可。
HF_ENDPOINT=https://hf-mirror.com

# 数据集与模型缓存目录（放在项目内，避免占用 C 盘）
HF_HOME=D:/dev/movie/.cache/huggingface

# ---- 后端 ----
# 服务监听地址与端口
HOST=127.0.0.1
PORT=8000

# 数据库文件
DATABASE_PATH=D:/dev/movie/data/history.db
