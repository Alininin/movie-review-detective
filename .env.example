# 复制本文件为 .env 后即可使用：copy .env.example .env（Windows）
# 相对路径按项目根目录解析，换台机器克隆下来不需要改路径。

# ---- Hugging Face ----
# 国内网络直接访问 huggingface.co 会超时，这里默认指向镜像站。
# 如果你的网络能直连官方站，把这一行改成：HF_ENDPOINT=
# 完全离线时：把下载好的缓存目录拷过来，把 HF_HOME 指向它，并清空 HF_ENDPOINT。
HF_ENDPOINT=https://hf-mirror.com

# 数据集与模型缓存目录（默认放在项目内，避免占用系统盘）
HF_HOME=./.cache/huggingface

# ---- 后端 ----
# 服务监听地址与端口
HOST=127.0.0.1
PORT=8000

# 分析历史数据库
DATABASE_PATH=./data/history.db
