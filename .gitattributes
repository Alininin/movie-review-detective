# 统一换行符，避免 Windows / macOS / Linux 之间互相改文件
* text=auto eol=lf

*.py     text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.json   text eol=lf
*.js     text eol=lf
*.vue    text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.yml    text eol=lf
*.toml   text eol=lf
*.ps1    text eol=lf
*.bat    text eol=crlf
*.cmd    text eol=crlf

# 数据与实验产物按字节原样保存，不做换行符转换。
# 这样「重跑脚本得到同一份 reviews.csv、SHA256 完全一致」这条可复现性结论，
# 在别人克隆下来的机器上依然成立。
data/*.csv        -text
data/*.json       -text
data/*.sampling   -text
experiments/*.csv -text
experiments/*.json -text

# 二进制产物
*.png     binary
*.jpg     binary
*.svg     text eol=lf
*.npy     binary
*.joblib  binary
*.db      binary
*.docx    binary
*.xlsx    binary
*.pptx    binary
*.pdf     binary
