# ---- Python ----
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- 缓存与临时文件（数据集与模型缓存在 .cache/，体积约 0.5 GB，不入库）----
.cache/
.tmp/
*.log

# ---- 本地配置 ----
.env

# ---- 前端依赖（dist 有意提交，见 README：后端直接托管构建产物）----
frontend/node_modules/

# ---- 运行期数据库 ----
data/history.db
data/history.db-journal

# ---- 系统 ----
Thumbs.db
desktop.ini
.DS_Store

# ---- 临时文件（本地调试用，不入库）----
/__*.py
/__*.db
/__*.log
/__shots/
/__edge-profile/

# ---- 只在本机保留、不进公开仓库的提交材料 ----
/report/
/AI_USAGE.md
/docs/requirements-and-plan.md
/submission/

# ---- 说明 ----
# 以下产物需要提交，不要忽略：
#   data/*.csv, data/*.json     抽样清单、数据文件、统计结果
#   data/embeddings.npy         500 条影评向量（约 750 KB）
#   models/*.joblib             TF-IDF + 逻辑回归模型文件
#   experiments/*.json,csv,md,png  评测与实验材料
#   frontend/dist/              前端构建产物
